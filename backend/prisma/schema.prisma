generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

/// Everyone who can sign in. Roles and `active` are read per request, so a
/// revoked role or a deactivated account takes effect immediately.
model User {
  id        String   @id @default(uuid()) @map("user_id")
  /// The Supabase user id (`sub`); null until the first Supabase sign-in.
  authId    String?  @unique @map("auth_id")
  email     String   @unique
  name      String
  roles     String[] @default(["user"])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
