# ===========================================
# Backend
# ===========================================
# Copy this file to backend/.env and fill in the values.
# NEVER commit real values: backend/.env is in .gitignore.

# -------------------------------------------
# Server
# -------------------------------------------
# development | test | production. On staging and production: production.
NODE_ENV=development
# The backend port. The Vite dev server (5173) proxies /api here.
PORT=3001
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# The frontend origin (CORS). Locally the Vite dev server.
CORS_ORIGIN=http://localhost:5173
# The header with the client's IP address, for the rate limiter. On
# DigitalOcean App Platform: do-connecting-ip. Leave empty locally.
CLIENT_IP_HEADER=

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
# Locally via `docker compose up -d --wait db` in the repo root.
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Only for a managed Postgres (staging/production): its CA certificate (PEM).
# Leave empty locally. When set, the dev login refuses to start.
DATABASE_CA_CERT=

# -------------------------------------------
# Sign-in with Microsoft (Supabase)
# -------------------------------------------
# The Supabase project, for example https://<ref>.supabase.co. The backend
# verifies tokens with the project's public keys; no secret key is needed.
# Empty until the project exists: every Supabase token is then refused (401)
# and only the dev login works. Required with NODE_ENV=production.
SUPABASE_URL=

# -------------------------------------------
# Dev login (local or Codespace only)
# -------------------------------------------
# Sign in with one click as a test user or test admin, without Microsoft.
# Only the dev server (`npm run dev`) knows it; it is never in the build. Works
# only when NODE_ENV is not production, DATABASE_CA_CERT is empty and
# DATABASE_URL points to a local database. NEVER enable on staging/production.
DEV_LOGIN_ENABLED=false
# Signs the session cookie (at least 32 characters). Create one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
DEV_LOGIN_SECRET=
