# ===========================================
# Frontend
# ===========================================
# Copy this file to frontend/.env. Vite reads only variables that start with
# VITE_ and bakes them into the code at build time: everything here is public.
# NEVER put a secret in a VITE_ variable.

# Supabase (sign-in with Microsoft). Empty until the Supabase project exists:
# the sign-in page then says Microsoft sign-in is not set up yet. The
# publishable key is public and meant for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dev login as test user or test admin, without Microsoft. Development only,
# locally or in a Codespace: the buttons appear only in the Vite dev server
# (`npm run dev`), never in a build. The backend needs it on too
# (DEV_LOGIN_ENABLED=true and a DEV_LOGIN_SECRET in backend/.env).
VITE_DEV_LOGIN_ENABLED=false

# Only needed when the backend does not run on the same origin under /api.
# Leave empty: locally the dev server proxies /api to port 3001 (vite.config.ts).
VITE_API_URL=

# Dev server only (not VITE_, never in the build): where /api goes. Empty means
# http://127.0.0.1:3001. Set it when the backend runs on another PORT.
API_PROXY_TARGET=
